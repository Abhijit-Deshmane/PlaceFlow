# Server
PORT=3001

# Database — PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/placeflow?schema=public"

# CORS
CORS_ORIGIN="http://localhost:3000"

# JWT (for future auth)
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
