# Server
PORT=3001
NODE_ENV=development

# Database — PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/placeflow?schema=public"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Clerk — server-side only. NEVER expose to clients.
# Get these from https://dashboard.clerk.com → Your App → API Keys
CLERK_SECRET_KEY="sk_test_your_secret_key_here"

# Optional: Clerk webhook secret for syncing user events
# Get from: https://dashboard.clerk.com → Webhooks → Signing Secret
CLERK_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
